SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Push notifications (M4) — public half of a VAPID keypair, safe to ship in
# the client. Generate with e.g. `npx web-push generate-vapid-keys`; the
# private half goes ONLY in the notify-new-message edge function's secrets,
# never here. See ROADMAP.md's M4 section for the full setup checklist.
VAPID_PUBLIC_KEY=your-vapid-public-key
